# ============================================
# SciFlow 后端环境变量（复制为 .env 后填写）
# cp apps/server/.env.example apps/server/.env
# ============================================

# 后端端口
PORT=3000

# SQLite 数据库文件路径（默认 apps/server/data/sciflow.db）
# DATABASE_PATH=./data/sciflow.db

# ------------------------------------------------------------
# AI 服务配置（OpenAI 兼容协议，支持多家厂商）
# 任选其一即可：
#   OpenAI   https://api.openai.com/v1   + OpenAI Key
#   DeepSeek https://api.deepseek.com/v1  + DeepSeek Key
#   通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1 + 阿里云 DashScope Key
#   豆包     https://ark.cn-beijing.volces.com/api/v3 + 火山方舟 Key
# ------------------------------------------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key-here
# 模型路由：fast=轻量快速（默认），strong=强模型（长文起草/评审/规划）
AI_MODEL_FAST=
AI_MODEL_STRONG=
AI_MODEL=gpt-4o-mini
# 免费版 RPM 限流额度（每分钟最多 N 次 AI 调用，令牌桶排队，稳定防 429）
AI_RPM_CAP=8

# CORS 允许来源（逗号分隔；* 全放行）。默认仅放行本地前端 :5173
# CORS_ORIGIN=http://localhost:5173,http://localhost:8080
