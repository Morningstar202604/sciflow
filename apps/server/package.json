    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.9.0",
    "docx": "^9.7.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "node-llama-cpp": "^3.12.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
